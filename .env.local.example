# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Website audit leads → n8n Webhook (server-only; never expose in NEXT_PUBLIC_*)
# Use the Webhook node’s Production URL (/webhook/…). Test URLs (/webhook-test/…) only work briefly in the editor.
# If unset in production, the app falls back to lib/leads/n8n-webhook-defaults.ts (override here for staging).
WEBSITE_AUDIT_N8N_WEBHOOK_URL=

# Request demo leads → n8n Webhook (server-only)
# If unset, same built-in default as website audit (see lib/leads/n8n-webhook-defaults.ts).
REQUEST_DEMO_N8N_WEBHOOK_URL=

# Optional: sent as X-Webhook-Secret on outbound requests if n8n expects it
N8N_WEBHOOK_SECRET=

# Optional: canonical site URL for links (recommended for correct unsubscribe redirect host in prod)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: marketing unsubscribe — Next.js proxies /unsubscribe to n8n (POST JSON), then redirects to /unsubscribed.
# UNSUBSCRIBE_N8N_WEBHOOK_URL = production Webhook URL only (no ?query); see Webhook node “Production URL”.
#
# Emails sent from n8n: point the footer (and any other) Unsubscribe anchor directly at that same webhook via GET,
# passing the recipient, e.g. .../webhook/<uuid>?email={{user_email}} (use whichever expression your Send Email node resolves for the recipient).
UNSUBSCRIBE_N8N_WEBHOOK_URL=
